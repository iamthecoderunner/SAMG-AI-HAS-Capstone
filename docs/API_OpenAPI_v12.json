            "type": "string",
            "title": "Decision"
          }
        },
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "DecisionIn"
      },
      "DocIn": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 150,
            "minLength": 3,
            "title": "Title"
          },
          "body": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 20,
            "title": "Body"
          }
        },
        "type": "object",
        "required": [
          "title",
          "body"
        ],
        "title": "DocIn"
      },
      "DocumentRevision": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 150,
            "minLength": 3,
            "title": "Title"
          },
          "body": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 20,
            "title": "Body"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          }
        },
        "type": "object",
        "required": [
          "title",
          "body",
          "expected_version"
        ],
        "title": "DocumentRevision"
      },
      "EscalateIn": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 5,
            "title": "Message"
          },
          "category": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Category",
            "default": "Other"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "EscalateIn"
      },
      "FeedbackIn": {
        "properties": {
          "resolved": {
            "type": "boolean",
            "title": "Resolved"
          }
        },
        "type": "object",
        "required": [
          "resolved"
        ],
        "title": "FeedbackIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "StatusIn": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "StatusIn"
      },
      "TicketIn": {
        "properties": {
          "category": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Category"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 5,
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "category",
          "description"
        ],
        "title": "TicketIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
