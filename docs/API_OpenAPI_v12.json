          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_document_api_documents_upload_post"
      },
      "ChatIn": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 2,
            "title": "Message"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 8
              },
