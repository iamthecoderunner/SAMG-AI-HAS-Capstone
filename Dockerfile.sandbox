FROM python:3.12-slim
WORKDIR /service
RUN pip install --no-cache-dir "fastapi>=0.115,<1" "uvicorn>=0.30,<1"
COPY integrations ./integrations
RUN useradd -r -u 10001 webhook && mkdir -p /data && chown webhook:webhook /data
USER webhook
EXPOSE 8001
CMD ["uvicorn","integrations.sandbox_webhook:app","--host","0.0.0.0","--port","8001"]
